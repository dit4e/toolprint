{
  "mcpServers": {
    "mcp-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/tmp"
      ]
    },
    "mcp-memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "mcp-everything": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-everything"
      ]
    },
    "mcp-seqthinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "mcp-git": {
      "command": "uvx",
      "args": [
        "mcp-server-git"
      ]
    },
    "mcp-time": {
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ]
    },
    "mcp-fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
